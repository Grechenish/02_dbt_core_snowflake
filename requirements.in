# Top-level Python dependencies. requirements.txt is the full lock compiled from this file,
# so every transitive package is pinned and Docker/CI builds are reproducible. To upgrade:
#   pip install uv
#   uv pip compile requirements.in --universal --python-version 3.14 -o requirements.txt
