# Copy to .env and fill in. .env is git-ignored.
# Account identifier format: <orgname>-<account_name>  (Snowsight > profile menu > Account > View account details)
SNOWFLAKE_ACCOUNT=

# Local development (dbt target `dev`): your own Snowflake user. dbt opens a browser to log in.
# Models build into ANALYTICS_DEV.DEV_<SNOWFLAKE_USER>_*; set DBT_SCHEMA to pick another prefix.
SNOWFLAKE_USER=
# DBT_SCHEMA=DEV_VIKTOR

# Service users only (prod/ci targets and the loader), normally set as GitHub Actions secrets:
# the full contents of the user's .p8 private key file, BEGIN/END lines included.
# SNOWFLAKE_PRIVATE_KEY=
